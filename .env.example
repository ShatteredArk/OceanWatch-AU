# =============================================================================
# OceanWatch AU — Environment Variables
# Copy this file to .env.local and fill in values for local development.
# NEVER commit .env.local or any file containing real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Vercel Postgres (PostGIS)
# Provided automatically in Vercel deployments. For local dev, use a local
# PostgreSQL instance with PostGIS extension, or a Vercel Postgres branch.
# See: https://vercel.com/docs/storage/vercel-postgres
# -----------------------------------------------------------------------------
POSTGRES_URL=postgresql://user:password@localhost:5432/oceanwatch
POSTGRES_URL_NON_POOLING=postgresql://user:password@localhost:5432/oceanwatch

# -----------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE)
# Register at https://dataspace.copernicus.eu/ — free tier.
# Create OAuth client credentials at:
#   https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# Scopes needed: openid, offline_access
# -----------------------------------------------------------------------------
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# -----------------------------------------------------------------------------
# Copernicus Marine Service (CMEMS)
# Register at https://marine.copernicus.eu/ — free tier.
# Used for derived oil spill detection products where available.
# -----------------------------------------------------------------------------
CMEMS_USERNAME=your-cmems-username
CMEMS_PASSWORD=your-cmems-password

# -----------------------------------------------------------------------------
# Vercel Blob
# Provided automatically in Vercel deployments. For local dev, see:
# https://vercel.com/docs/storage/vercel-blob/quickstart
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# -----------------------------------------------------------------------------
# Cron security
# A shared secret to authenticate /api/cron/* calls.
# In Vercel, cron requests come from Vercel servers; this adds defence-in-depth.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# Sentry (error monitoring)
# Create a project at https://sentry.io/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://example@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=oceanwatch-au
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# -----------------------------------------------------------------------------
# App settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
